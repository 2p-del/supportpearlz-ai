# Required for Gemini chat generation
GOOGLE_API_KEY=put_your_gemini_api_key_here
# Chat model
LLM_MODEL=gemini-2.5-flash
# Local embedding model; the same model is used at index and query time
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG settings
CHUNK_SIZE=850
CHUNK_OVERLAP=140
TOP_K=5
# FAISS similarity distance threshold; tune with your own test set
MAX_DISTANCE=1.35
VECTOR_STORE_PATH=data/vector_store/faiss_index
KNOWLEDGE_BASE_PATH=data/knowledge_base
LOG_LEVEL=INFO
SUPPORT_EMAIL=support@pearlzhome.example
